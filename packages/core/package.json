{
	"name": "@tallyrelease/core",
	"version": "0.4.1",
	"description": "Pure planning core of tallyrelease",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abinnovision/tallyrelease.git",
		"directory": "packages/core"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"development": "./src/testing/index.ts",
			"import": "./dist/testing/index.js",
			"default": "./dist/testing/index.js"
		},
		"./testing/conformance": {
			"types": "./dist/testing/conformance.d.ts",
			"development": "./src/testing/conformance.ts",
			"import": "./dist/testing/conformance.js",
			"default": "./dist/testing/conformance.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --build tsconfig.build.json",
		"check:purity": "node ../../tools/check-purity.mjs src/index.ts",
		"format:check": "prettier --check '{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml,css,html,gql,graphql}'",
		"format:fix": "prettier --write '{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml,css,html,gql,graphql}'",
		"lint:check": "eslint '{{src,test}/**/*,*}.{t,j}s{,x}'",
		"lint:fix": "eslint '{{src,test}/**/*,*}.{t,j}s{,x}' --fix",
		"test-unit": "vitest --passWithNoTests --run --coverage --config vitest.config.ts --project='*#unit'",
		"test-unit:watch": "vitest --passWithNoTests --config vitest.config.ts --project='*#unit'",
		"typecheck": "tsc -p tsconfig.json"
	},
	"lint-staged": {
		"{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml,css,html,gql,graphql}": "prettier --write",
		"{{src,test}/**/*,*}.{t,j}s{,x}": "eslint --fix"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"@standard-schema/spec": "^1.1.0",
		"picomatch": "^4.0.7",
		"semver": "^7.8.5"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/prettier-config": "^2.2.0",
		"@internal/tsconfig": "workspace:*",
		"@types/node": "^26.6.5",
		"@types/picomatch": "^4.0.3",
		"@types/semver": "^7.8.0",
		"@vitest/coverage-v8": "^5.0.4",
		"eslint": "^10.12.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"yaml": "^2.9.1"
	},
	"peerDependencies": {
		"vitest": "^5.0.3"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./testing": {
				"types": "./dist/testing/index.d.ts",
				"import": "./dist/testing/index.js",
				"default": "./dist/testing/index.js"
			},
			"./testing/conformance": {
				"types": "./dist/testing/conformance.d.ts",
				"import": "./dist/testing/conformance.js",
				"default": "./dist/testing/conformance.js"
			}
		},
		"npm": true
	}
}
